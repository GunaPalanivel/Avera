# Copy to .env for local overrides (never commit .env)

# Deterministic behavioral recency anchor (default 2026-06-27)
AVERA_REFERENCE_DATE=2026-06-27

# Skip semantic prefill and cross-encoder rerank (CI/sandbox fast path)
AVERA_SKIP_SEMANTIC=0
AVERA_SKIP_RERANK=0

# Heuristic funnel: max candidates to embed in pass 1 (default 5000)
AVERA_SEMANTIC_RERANK_TOPK=5000
